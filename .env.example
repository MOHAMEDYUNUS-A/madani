# ==============================================================================
# MADANI ENTERPRISES ID PLATFORM - PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# NOTE: Copy this file to .env and replace all placeholders with strong production values.
# Never commit real passwords, JWT secrets, or production API keys to git.

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=production                   # options: development, staging, production, testing
APP_VERSION=2.0.0
PORT=8000
DEBUG=false

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 15)
# ------------------------------------------------------------------------------
# Internal connection string for dockerized services:
DATABASE_URL=postgresql://madani_admin:ChangeThisStrongSecretInProd!@db:5432/madani_production
POSTGRES_USER=madani_admin
POSTGRES_PASSWORD=ChangeThisStrongSecretInProd!
POSTGRES_DB=madani_production

# ------------------------------------------------------------------------------
# 3. REDIS & CELERY ASYNCHRONOUS WORKER
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-64-character-random-hex-string-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440        # 24 hours token lifetime

# ------------------------------------------------------------------------------
# 5. CROSS-ORIGIN RESOURCE SHARING (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Do NOT use * in production.
CORS_ORIGINS=https://app.madani-id.com,https://staging.madani-id.internal,http://localhost:3000

# ------------------------------------------------------------------------------
# 6. STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
STORAGE_MODE=local                      # options: local, s3
STORAGE_DIR=/app/storage                # Mounted docker volume path

# Optional AWS S3 settings (only required if STORAGE_MODE=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=madani-id-assets-prod

# ------------------------------------------------------------------------------
# 7. AI DESIGN ASSISTANT
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-placeholder-replace-with-your-real-openai-or-gemini-key

# ------------------------------------------------------------------------------
# 8. SRE MONITORING & OBSERVABILITY
# ------------------------------------------------------------------------------
SENTRY_DSN=                             # Optional Sentry error tracking DSN
METRICS_ENABLED=true                    # Exposes /metrics for Prometheus scraping
