# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/madani_db

# Security
JWT_SECRET=supersecretjwtsecretkeychangeinproduction12345!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Storage
# Set STORAGE_MODE to 'local' for local file storage or 's3' for object storage
STORAGE_MODE=local
STORAGE_DIR=c:/Users/niran/Desktop/Madani/storage
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=madani-assets

# External Services
EMAIL_API_KEY=
PAYMENT_API_KEY=

# App Settings
ENV=development
